{
  "name": "setup-unirtm",
  "description": "GitHub Action to setup UniRTM (Uni Runtime and Tools Manager)",
  "version": "0.4.0",
  "author": "Snowdream Tech",
  "private": true,
  "homepage": "https://github.com/snowdreamtech/setup-unirtm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowdreamtech/setup-unirtm.git"
  },
  "bugs": {
    "url": "https://github.com/snowdreamtech/setup-unirtm/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "unirtm"
  ],
  "exports": {
    ".": "./dist/index.cjs"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx vitest run --coverage",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package:index": "npx -y esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs",
    "package:post": "npx -y esbuild src/post.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/post.cjs",
    "package": "npm run package:index && npm run package:post",
    "package:watch": "npm run package -- --watch",
    "test": "npx vitest run --coverage",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "6.0.1",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/glob": "0.7.0",
    "handlebars": "4.7.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/handlebars": "4.1.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitest/coverage-v8": "4.1.8",
    "esbuild": "0.28.1",
    "eslint": "10.4.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,json}": [
      "prettier --write"
    ]
  }
}
